@model IEnumerable<UserRoleDto>
@{
    ViewData["Title"] = "List Of Users";
}
@if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(i => i.Id)</th>
                        <th>@Html.DisplayNameFor(i => i.UserName)</th>
                        <th>@Html.DisplayNameFor(i => i.Email)</th>
                        <th>@Html.DisplayNameFor(i => i.Roles)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="align-middle">
                                @Html.DisplayFor(i => user.Id)
                            </td>
                            <td class="align-middle">
                                @Html.DisplayFor(i => user.UserName)
                            </td>
                            <td class="align-middle">
                                @Html.DisplayFor(i => user.Email)
                            </td>
                            <td class="align-middle">
                                @Html.DisplayFor(i => user.Roles)
                            </td>
                            <td class="align-middle">
                                <a class="btn btn-outline-success" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id">
                                    <i class="bi bi-pencil-square">Make Moderator</i></a>
                                <a class="btn btn-outline-danger" asp-controller="Users" asp-action="Delete" asp-route-id="@user.Id"><i class="bi bi-trash">Deactivate Account</i></a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tr>
                    <td></td>
                </tr>
            </table>
        </div>
    </div>
}
